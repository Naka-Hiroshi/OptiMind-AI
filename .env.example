# OptiMind AI settings, when running from source: copy this file to ".env"
# and fill in your keys (or set them in the app's Settings page, which also
# edits this file). The installed app keeps the same settings in
# %LOCALAPPDATA%\OptiMind\settings.env. Never commit the real ".env" file
# to a public repository.

# --- AI providers (all free) ---
# Order to try them in. If one fails (no key, free quota used up, no
# internet), the next one is used. "local" is the built-in rule-based
# brain: offline, always works, and is always used as the last resort.
OPTIMIND_AI_PROVIDERS=gemini,groq,local

# Google Gemini — free key at https://aistudio.google.com/apikey
# Note: on the free tier, Google may use the data you send to improve
# its products (here: CPU/RAM numbers and process names).
GEMINI_API_KEY=
OPTIMIND_GEMINI_MODEL=gemini-3.8-flash

# Groq — free key at https://console.groq.com/keys
GROQ_API_KEY=
OPTIMIND_GROQ_MODEL=openai/gpt-oss-120b

# Ollama (optional) — free AI running on your own PC (https://ollama.com).
# Set the model you pulled and add "ollama" to OPTIMIND_AI_PROVIDERS.
OPTIMIND_OLLAMA_URL=http://localhost:11434/v1
OPTIMIND_OLLAMA_MODEL=

# --- Agent ---
# Interval (seconds) of the FAST loop (monitor + immediate optimizations).
OPTIMIND_FAST_LOOP_SECONDS=2

# Interval (seconds) of the AI loop (policy review).
# 900 = every 15 minutes (96 reviews/day). Free tiers have daily
# request limits, so don't set this much lower.
OPTIMIND_AI_LOOP_SECONDS=900

# --- App ---
# OptiMind's language: en (English), pt-BR (Português, Brasil)… Empty: the
# language Windows shows, when OptiMind has it, else English. Settings →
# Language changes it.
OPTIMIND_LANGUAGE=

# Port of the local dashboard and API.
OPTIMIND_API_PORT=8765

# Ask Windows for administrator rights at start (its usual "allow this app
# to make changes" prompt). They let OptiMind empty the standby list, merge
# identical memory pages, manage your apps that run as administrator and
# change startup apps for all users. Windows services and protected
# processes stay off-limits either way.
OPTIMIND_RUN_AS_ADMIN=true
